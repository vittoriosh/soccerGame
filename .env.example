# Postgres connection string (Supabase / Neon / local Docker)
# Supabase: Project Settings → Database → Connect → ORMs → Prisma
# Session pooler (port 5432) is enough for local + migrate.
# Example: postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Optional. Needed on Vercel if DATABASE_URL is the transaction pooler (port 6543).
# Use the session pooler or direct connection (port 5432).
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Optional. Old Prisma Postgres URL, used only by `npm run db:dump` so we can
# copy data after you have already pointed DATABASE_URL at Supabase.
# SOURCE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
